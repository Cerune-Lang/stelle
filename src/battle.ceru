pub type Battle {
    hero_hp: i64,
    slime_hp: i64,
    potions: i64,
    escaped: bool,
}

pub enum Action {
    Attack,
    Heal,
    Run,
}

// An engine turn contains all state changes and presentation events.
// The rules below never print: callers can render or simulate turns.
pub enum Event {
    Attack,
    Heal,
    NoPotions,
    Run,
    None,
}

pub type Turn {
    state: Battle,
    event: Event,
    enemy_attacked: bool,
}

pub fn start() -> Battle {
    return Battle {
        hero_hp: 10,
        slime_hp: 12,
        potions: 1,
        escaped: false,
    };
}

fn clamp_hero_hp(value: i64) -> i64 {
    if value < 0 {
        return 0;
    }
    if value > 10 {
        return 10;
    }
    return value;
}

fn clamp_slime_hp(value: i64) -> i64 {
    if value < 0 {
        return 0;
    }
    return value;
}

// Pure transition: UI code must not decide damage, resource use, or turn order.
pub fn advance(state: Battle, action: Action) -> Turn {
    if state.hero_hp <= 0 || state.slime_hp <= 0 || state.escaped {
        return Turn {
            state: state,
            event: Event::None {},
            enemy_attacked: false,
        };
    }

    mut next: Battle = state;
    mut event: Event = Event::Attack {};

    match action {
        Action::Attack {} => {
            next = Battle {
                ..state,
                slime_hp: clamp_slime_hp(state.slime_hp - 4),
            };
        },
        Action::Heal {} => {
            if state.potions > 0 {
                event = Event::Heal {};
                next = Battle {
                    ..state,
                    hero_hp: clamp_hero_hp(state.hero_hp + 3),
                    potions: state.potions - 1,
                };
            } else {
                event = Event::NoPotions {};
            }
        },
        Action::Run {} => {
            event = Event::Run {};
            next = Battle { ..state, escaped: true };
        },
    }

    mut enemy_attacked: bool = false;
    if next.slime_hp > 0 && !next.escaped {
        enemy_attacked = true;
        next = Battle {
            ..next,
            hero_hp: clamp_hero_hp(next.hero_hp - 2),
        };
    }

    return Turn {
        state: next,
        event: event,
        enemy_attacked: enemy_attacked,
    };
}

// Compatibility wrapper for the current CLI demo.
pub fn step(state: Battle, action: Action) -> Battle {
    turn: Turn = advance(state, action);
    match turn.event {
        Event::Attack {} => { print("You attack for 4."); },
        Event::Heal {} => { print("You drink a potion (+3 HP)."); },
        Event::NoPotions {} => { print("No potions left."); },
        Event::Run {} => { print("You run away."); },
        Event::None {} => {},
    }
    if turn.enemy_attacked {
        print("Slime attacks for 2.");
    }
    return turn.state;
}

pub fn show(state: Battle) -> void {
    print("Hero HP");
    print(state.hero_hp);
    print("Slime HP");
    print(state.slime_hp);
    print("Potions");
    print(state.potions);
}
